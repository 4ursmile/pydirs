"""Type stubs for the native ``tinycache._tinycache`` extension.

These describe the bytes-level classes exposed by the Rust core. The public
``tinycache.Cache`` subclass adds decoding, JSON and pydantic helpers.
"""

from typing import Dict, Iterable, List, Mapping, Optional, Set, Union

Key = Union[str, bytes, int, float]
Value = Union[str, bytes, int, float]

class Cache:
    """Bytes-level cache backed by the Rust core. Subclassable."""

    def __init__(
        self,
        max_memory: int = 0,
        policy: str = "noeviction",
        shards: int = 64,
    ) -> None: ...
    def close(self) -> None: ...

    # strings
    def set(
        self,
        key: Key,
        value: Value,
        ex: Optional[int] = None,
        px: Optional[int] = None,
        nx: bool = False,
        xx: bool = False,
    ) -> bool: ...
    def get(self, key: Key) -> Optional[bytes]: ...
    def mget(self, keys: Iterable[Key]) -> List[Optional[bytes]]: ...
    def mset(self, mapping: Mapping[Key, Value]) -> None: ...
    def incr(self, key: Key, amount: int = 1) -> int: ...
    def decr(self, key: Key, amount: int = 1) -> int: ...
    def append(self, key: Key, value: Value) -> int: ...

    # keys
    def delete(self, *keys: Key) -> int: ...
    def exists(self, key: Key) -> bool: ...
    def expire(self, key: Key, seconds: int) -> bool: ...
    def pexpire(self, key: Key, milliseconds: int) -> bool: ...
    def persist(self, key: Key) -> bool: ...
    def ttl(self, key: Key) -> int: ...
    def pttl(self, key: Key) -> int: ...
    def keys(self, pattern: str = "*") -> List[bytes]: ...
    def flush(self) -> None: ...
    @property
    def used_memory(self) -> int: ...
    def __len__(self) -> int: ...

    # hashes
    def hset(self, key: Key, field: Key, value: Value) -> bool: ...
    def hget(self, key: Key, field: Key) -> Optional[bytes]: ...
    def hdel(self, key: Key, *fields: Key) -> int: ...
    def hgetall(self, key: Key) -> Dict[bytes, bytes]: ...
    def hlen(self, key: Key) -> int: ...

    # lists
    def lpush(self, key: Key, *values: Value) -> int: ...
    def rpush(self, key: Key, *values: Value) -> int: ...
    def lpop(self, key: Key) -> Optional[bytes]: ...
    def rpop(self, key: Key) -> Optional[bytes]: ...
    def lrange(self, key: Key, start: int, stop: int) -> List[bytes]: ...
    def llen(self, key: Key) -> int: ...

    # sets
    def sadd(self, key: Key, *members: Value) -> int: ...
    def srem(self, key: Key, *members: Value) -> int: ...
    def smembers(self, key: Key) -> Set[bytes]: ...
    def sismember(self, key: Key, member: Value) -> bool: ...
    def scard(self, key: Key) -> int: ...

class Server:
    """RESP2 server backed by a ``Cache``."""

    def __init__(
        self,
        cache: Cache,
        host: str = "127.0.0.1",
        port: int = 6380,
    ) -> None: ...
    def start(self) -> None: ...
    def stop(self) -> None: ...
    @property
    def port(self) -> int: ...
    @property
    def running(self) -> bool: ...
